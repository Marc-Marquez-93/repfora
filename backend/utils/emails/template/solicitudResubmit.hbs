<html>
  <head>
    <style>
      .container { font-family: Arial, sans-serif; max-width: 650px; margin: 0 auto; color: #333; }
      .header { background-color: #f9a825; color: #fff; padding: 20px; text-align: center; border-radius: 8px 8px 0 0; }
      .header h2 { margin: 0; }
      .body { padding: 20px; background-color: #f9f9f9; }
      .alert-box { background-color: #fff8e1; border-left: 4px solid #f9a825; padding: 12px 16px; margin: 16px 0; border-radius: 4px; }
      .section-title { color: #e65100; font-size: 15px; margin-top: 20px; margin-bottom: 8px; border-bottom: 2px solid #f9a825; padding-bottom: 4px; }
      .detail-row { display: flex; padding: 6px 0; border-bottom: 1px solid #e0e0e0; }
      .detail-label { font-weight: bold; width: 40%; color: #555; font-size: 13px; }
      .detail-value { width: 60%; font-size: 13px; }
      .footer { padding: 15px 20px; background-color: #fff8e1; font-size: 12px; color: #666; border-radius: 0 0 8px 8px; text-align: center; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h2>Solicitud Modificada y Reenviada</h2>
      </div>
      <div class="body">
        <div class="alert-box">
          El instructor <strong>{{instructorName}}</strong> ha modificado y reenviado la solicitud de formacion complementaria que habia sido rechazada. A continuacion se muestran los datos completos actualizados de la solicitud.
        </div>

        <div class="section-title">Datos de la Solicitud</div>
        <div class="detail-row">
          <span class="detail-label">Numero de solicitud:</span>
          <span class="detail-value">{{numeroSolicitud}}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Instructor:</span>
          <span class="detail-value">{{instructorName}}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Fecha de reenvio:</span>
          <span class="detail-value">{{resubmitDate}}</span>
        </div>

        <div class="section-title">Datos del Curso</div>
        <div class="detail-row">
          <span class="detail-label">Curso:</span>
          <span class="detail-value">{{courseName}}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Codigo:</span>
          <span class="detail-value">{{courseCode}}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Version:</span>
          <span class="detail-value">{{courseVersion}}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Duracion maxima (horas):</span>
          <span class="detail-value">{{prfDuracionMaxima}}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Tipo de programa:</span>
          <span class="detail-value">{{tipoPrograma}}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Tipo de poblacion:</span>
          <span class="detail-value">{{tipoPoblacion}}</span>
        </div>

        <div class="section-title">Fechas del Programa</div>
        <div class="detail-row">
          <span class="detail-label">Fecha de inicio:</span>
          <span class="detail-value">{{fechaInicio}}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Fecha de finalizacion:</span>
          <span class="detail-value">{{fechaFin}}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Fecha de inscripcion:</span>
          <span class="detail-value">{{fechaInscripcion}}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Matricula inicio:</span>
          <span class="detail-value">{{fechaMatriculaInicio}}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Matricula fin:</span>
          <span class="detail-value">{{fechaMatriculaFin}}</span>
        </div>

        <div class="section-title">Ubicacion</div>
        <div class="detail-row">
          <span class="detail-label">Municipio:</span>
          <span class="detail-value">{{municipio}}</span>
        </div>
        {{#if vereda}}
        <div class="detail-row">
          <span class="detail-label">Vereda:</span>
          <span class="detail-value">{{vereda}}</span>
        </div>
        {{/if}}
        <div class="detail-row">
          <span class="detail-label">Direccion:</span>
          <span class="detail-value">{{direccion}}</span>
        </div>
        {{#if ambienteNombre}}
        <div class="detail-row">
          <span class="detail-label">Ambiente:</span>
          <span class="detail-value">{{ambienteNombre}}</span>
        </div>
        {{/if}}
        {{#if ambienteDireccion}}
        <div class="detail-row">
          <span class="detail-label">Direccion ambiente:</span>
          <span class="detail-value">{{ambienteDireccion}}</span>
        </div>
        {{/if}}

        <div class="section-title">Empresa Asociada</div>
        {{#if nombreEmpresa}}
        <div class="detail-row">
          <span class="detail-label">Nombre empresa:</span>
          <span class="detail-value">{{nombreEmpresa}}</span>
        </div>
        {{/if}}
        {{#if nitEmpresa}}
        <div class="detail-row">
          <span class="detail-label">NIT empresa:</span>
          <span class="detail-value">{{nitEmpresa}}</span>
        </div>
        {{/if}}
        {{#if contactoEmpresa}}
        <div class="detail-row">
          <span class="detail-label">Contacto empresa:</span>
          <span class="detail-value">{{contactoEmpresa}}</span>
        </div>
        {{/if}}
        {{#if telefonoEmpresa}}
        <div class="detail-row">
          <span class="detail-label">Telefono empresa:</span>
          <span class="detail-value">{{telefonoEmpresa}}</span>
        </div>
        {{/if}}

        <div class="section-title">Aprendices y Requisitos</div>
        <div class="detail-row">
          <span class="detail-label">No. Aprendices:</span>
          <span class="detail-value">{{numAprendices}}</span>
        </div>
        {{#if requisitosIngreso}}
        <div class="detail-row">
          <span class="detail-label">Requisitos de ingreso:</span>
          <span class="detail-value">{{requisitosIngreso}}</span>
        </div>
        {{/if}}
        {{#if recursosNecesarios}}
        <div class="detail-row">
          <span class="detail-label">Recursos necesarios:</span>
          <span class="detail-value">{{recursosNecesarios}}</span>
        </div>
        {{/if}}
        {{#if proyectoAsociado}}
        <div class="detail-row">
          <span class="detail-label">Proyecto asociado:</span>
          <span class="detail-value">{{proyectoAsociado}}</span>
        </div>
        {{/if}}

        {{#if competencias}}
        <div class="section-title">Competencias</div>
        <div style="padding: 6px 0; font-size: 13px; color: #555;">
          {{#each competencias}}
            <div style="padding: 3px 0; border-bottom: 1px solid #eee;">{{this}}</div>
          {{/each}}
        </div>
        {{/if}}

        {{#if resultados}}
        <div class="section-title">Resultados de Aprendizaje</div>
        <div style="padding: 6px 0; font-size: 13px; color: #555;">
          {{#each resultados}}
            <div style="padding: 3px 0; border-bottom: 1px solid #eee;">{{this}}</div>
          {{/each}}
        </div>
        {{/if}}

        {{#if supervisorNombre}}
        <div class="section-title">Supervisor</div>
        <div class="detail-row">
          <span class="detail-label">Nombre supervisor:</span>
          <span class="detail-value">{{supervisorNombre}}</span>
        </div>
        {{/if}}

        <p style="margin-top: 20px;">Por favor ingrese al sistema para revisar y aprobar o rechazar la solicitud modificada.</p>
      </div>
      <div class="footer">
        Este mensaje fue enviado automaticamente por el sistema REPORA - SENA. No responda a este correo.
      </div>
    </div>
  </body>
</html>
